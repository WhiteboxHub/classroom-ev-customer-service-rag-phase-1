# ==============================================================
# EV RAG Platform — Environment Configuration
# Copy to .env and fill in your values
# ==============================================================

# ── Groq (recommended — free tier at https://console.groq.com) ─
# If GROQ_API_KEY is set, Groq is used instead of OpenAI.
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI (fallback when GROQ_API_KEY is unset) ───────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# ── Milvus Vector Store ───────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=ev_troubleshooting
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE

# ── Redis Cache & Celery Broker ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# ── PostgreSQL Metadata Database ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=evrag
POSTGRES_PASSWORD=evrag_password
POSTGRES_DB=evragdb
POSTGRES_ENABLED=false

# ── Celery Async Workers ──────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
WORKER_CONCURRENCY=4

# ── Embeddings & Reranking ────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_CACHE_ENABLED=true

# ── Chunking ──────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Retrieval ─────────────────────────────────────────────────
SEMANTIC_TOP_K=10
BM25_TOP_K=10
HYBRID_TOP_K=8
RERANK_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35

# ── Langfuse Observability ────────────────────────────────────
# Get keys at https://cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=lf-pub-your-key
LANGFUSE_SECRET_KEY=lf-sec-your-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── OpenTelemetry Tracing ─────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ev-rag-platform

# ── Multi-Tenant ──────────────────────────────────────────────
DEFAULT_TENANT=ev_technicians
MULTI_TENANT_ENABLED=false

# ── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── AWS (for S3 connector) ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=ev-rag-docs

# ── Confluence (optional) ─────────────────────────────────────
CONFLUENCE_BASE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# ── SharePoint (optional) ─────────────────────────────────────
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=

# ── Internal Wiki (optional) ──────────────────────────────────
WIKI_API_URL=
WIKI_USERNAME=
WIKI_PASSWORD=
